# ESME CU ERP — environment template
# Copy to .env.local for local development. Never commit a filled-in copy.
# In production, set these in the hosting platform's secret manager instead.

# --- Supabase (authentication + database) ---
# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=
# Publishable anon key (safe for the browser). NOT the service role key.
VITE_SUPABASE_ANON_KEY=

# --- Server-side only. Must never appear in a VITE_ prefixed variable. ---
# Used by the bootstrap command and any migration script; keep it on the server.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Optional ---
# Site URL used in email verification and password-reset links.
PUBLIC_APP_URL=
# Turn the local development auth fallback off explicitly if it is ever unwanted.
ESME_DISABLE_LOCAL_DEV_AUTH=
