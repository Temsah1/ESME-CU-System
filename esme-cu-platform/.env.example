# ESME CU — environment template
# Copy to .env.local for local development. Never commit a filled-in copy.
# Set production values in the hosting platform's secret store, not in a file.
#
# This template lists only variables this repository actually reads. Adding a
# variable here does not make the app use it.

# --- Read by the client (src/auth/supabaseAdapter.ts) ---
# Both must be set to use the real provider. With neither set, a development build
# falls back to the local development auth adapter (banner on screen), and a
# production build refuses to sign in.
#
# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=
# The publishable anon key — safe for the browser. NOT the service role key:
# anything with a VITE_ prefix is inlined into the bundle.
VITE_SUPABASE_ANON_KEY=

# --- Outbound email: nothing here ---
# Mail is queued by database triggers and sent by the scheduled send-email Edge Function, so
# the browser holds no sender and needs no URL for one. The provider key and the scheduler
# secret are Edge Function secrets, set with `supabase secrets set` and listed in
# supabase/README.md. A variable with a VITE_ prefix would be compiled into the public bundle.

# --- Meta Graph sync: nothing here ---
# The sync-meta-insights Edge Function reads META_PAGE_ID, META_GRAPH_TOKEN,
# META_SYNC_CRON_SECRET and optionally META_GRAPH_VERSION from its own environment. They are
# deliberately absent from this template's client paths: any variable with a VITE_ prefix is
# inlined into the browser bundle, and META_GRAPH_TOKEN is a Page access token. Until the
# secrets exist, the function records a blocked run and makes no call to graph.facebook.com.
# Steps: supabase/README.md — "Social insight sync".

# --- Internal chat: the two client variables above, nothing else ---
# Messages calls only the RPCs in supabase/migrations/0018_chat.sql through VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY. There is no chat-only secret and no browser-local message store; with
# either variable missing the screen reports that chat is blocked instead of inventing a thread.
# Realtime needs esme_chat_messages in the supabase_realtime publication, which 0018 adds when the
# publication exists. Steps: supabase/README.md — "Internal chat".

# --- Not read by this app. Used by the commands in supabase/README.md ---
# Direct Postgres connection for pg_dump / psql when applying or verifying migrations.
# Keep it in the shell or the CI secret store; never in a VITE_ variable.
SUPABASE_DB_URL=

# --- Seeded test accounts (src/domain/testAccounts.ts, scripts/seed-test-accounts.mjs) ---
# Switched off by default. A development build seeds the three fixtures into the local vault from
# the Technical Support workspace without any variable set; a production bundle refuses until this
# says true, and the real provider never seeds from a browser at all — it is armed and seeded in the
# SQL editor, or through the command below.
VITE_ALLOW_TEST_ACCOUNTS=

# Read by `npm run seed:test-accounts` (Node, never the bundle). The command refuses unless this
# says development or staging, and the database refuses the same thing again on its own.
ESME_ENVIRONMENT=
# Optional: the passwords to seed. Absent means the command generates them and prints them once.
ESME_TEST_PASSWORD_HEAD=
ESME_TEST_PASSWORD_DIRECTOR=
ESME_TEST_PASSWORD_MEMBER=
